# Base URL of the FastAPI backend.
#
# Leave EXPO_PUBLIC_API_URL unset for the normal case — src/config.ts
# auto-detects your machine's LAN IP from Expo's dev-server host (the same
# address your phone already used to load the app), so you don't need to
# find/edit your IP by hand.
#
# Only set this to override the auto-detect:
#   - Android emulator (AVD):                            http://10.0.2.2:8000
#   - tunnelled/deployed backend (ngrok, cloud, etc):     https://your-tunnel-url
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Upload captures to POST /scans/from-image when online (LAB ML on server)
EXPO_PUBLIC_ML_ENABLED=true
