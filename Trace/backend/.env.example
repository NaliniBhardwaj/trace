# === REQUIRED (local demo defaults OK) ===
APP_NAME=SENTINEL API
ENV=development
DATABASE_URL=sqlite:///./sentinel_dev.db
JWT_SECRET_KEY=CHANGE_ME_INSECURE_DEV_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=*

# === OPTIONAL / ML ===
ML_ENABLED=true
ML_MODEL_PATH=model.pkl

# === DEMO-ONLY / SEED (default false — does not wipe DB) ===
SEED_DEMO_DATA=false

# === Phase 16 LLM (demo without key) ===
LLM_MODE=demo
LLM_PROVIDER=openai_compatible
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# === WhatsApp (optional) ===
WHATSAPP_PROVIDER=demo
WHATSAPP_DEMO_MODE=true

# === Release metadata ===
APP_VERSION=1.0.0
LOG_LEVEL=INFO
